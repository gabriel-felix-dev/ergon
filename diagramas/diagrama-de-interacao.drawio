  <diagram name="Página-1" id="cJ-D8NzpWaLJ2Z42YDqs">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Sistema de Assistência Técnica - Diagrama de Interação\n\nautonumber\n\nactor Cliente\nactor Funcionario\nactor Gerente\nparticipant Sistema\ndatabase BancoDeDados\n\n== Solicitação da Ordem de Serviço ==\n\nCliente -&gt; Sistema: Solicitar O.S.\\nInformar contato e dados do aparelho\nSistema -&gt; BancoDeDados: Consultar cliente pelo e-mail\n\nalt Cliente possui cadastro\n    BancoDeDados --&gt; Sistema: Dados do cliente encontrados\nelse Cliente ainda não possui cadastro\n    BancoDeDados --&gt; Sistema: Cliente não encontrado\n    Sistema -&gt; Sistema: Manter dados do solicitante\\nna solicitação da O.S.\nend\n\nSistema -&gt; BancoDeDados: Registrar aparelho\\n(tipo, marca e modelo)\nBancoDeDados --&gt; Sistema: aparelhoId\n\nSistema -&gt; BancoDeDados: Criar O.S.\\naparelhoId e dados do solicitante\nBancoDeDados --&gt; Sistema: ordemServicoId\nSistema --&gt; Cliente: Confirmar solicitação da O.S.\n\n== Análise e envio do orçamento ==\n\nFuncionario -&gt; Sistema: Abrir O.S. para análise\nSistema -&gt; BancoDeDados: Consultar O.S. e aparelho\nBancoDeDados --&gt; Sistema: Dados da O.S. e do aparelho\nSistema --&gt; Funcionario: Exibir informações da solicitação\n\nFuncionario -&gt; Sistema: Registrar análise e orçamento\nSistema -&gt; BancoDeDados: Salvar orçamento\\nvalor, validade e funcionário responsável\nBancoDeDados --&gt; Sistema: Orçamento registrado\nSistema --&gt; Cliente: Enviar orçamento para aprovação\n\nalt Cliente aprova o orçamento\n    Cliente -&gt; Sistema: Aprovar orçamento\n    Sistema -&gt; BancoDeDados: Registrar aprovação e data\n    BancoDeDados --&gt; Sistema: Aprovação registrada\n    Sistema -&gt; BancoDeDados: Atualizar status da O.S. para Aprovada\n\n    == Reparo e controle de peças ==\n\n    Funcionario -&gt; Sistema: Iniciar reparo da O.S.\n    Sistema -&gt; BancoDeDados: Consultar disponibilidade das peças\n    BancoDeDados --&gt; Sistema: Disponibilidade do estoque\n\n    alt Peças disponíveis\n        Sistema --&gt; Funcionario: Confirmar disponibilidade\n    else Peças indisponíveis\n        Funcionario -&gt; Sistema: Criar solicitação de peças\n        Sistema -&gt; BancoDeDados: Registrar solicitação e itens\n        BancoDeDados --&gt; Sistema: Solicitação registrada\n        Sistema --&gt; Gerente: Notificar solicitação de peças\n\n        Gerente -&gt; Sistema: Analisar solicitação\n        Sistema -&gt; BancoDeDados: Consultar solicitação\n        BancoDeDados --&gt; Sistema: Dados da solicitação\n\n        Gerente -&gt; Sistema: Aprovar atendimento da solicitação\n        Sistema -&gt; BancoDeDados: Atualizar status da solicitação\n        Sistema --&gt; Funcionario: Informar atendimento da solicitação\n\n        Gerente -&gt; Sistema: Registrar entrada das peças recebidas\n        Sistema -&gt; BancoDeDados: Atualizar saldo e registrar\\nmovimentação de entrada\n        BancoDeDados --&gt; Sistema: Estoque atualizado\n    end\n\n    Funcionario -&gt; Sistema: Registrar peças utilizadas na O.S.\n    Sistema -&gt; BancoDeDados: Associar IDs das peças à O.S.\n    Sistema -&gt; BancoDeDados: Registrar movimentação de saída\n    BancoDeDados --&gt; Sistema: Uso das peças registrado\n\n    Funcionario -&gt; Sistema: Registrar conclusão do reparo\n    Sistema -&gt; BancoDeDados: Atualizar status da O.S. para Concluída\n    BancoDeDados --&gt; Sistema: O.S. atualizada\n    Sistema --&gt; Cliente: Informar que o reparo foi concluído\n\n    == Pagamento ==\n\n    Cliente -&gt; Funcionario: Realizar pagamento\n    Funcionario -&gt; Sistema: Registrar pagamento do serviço\n    Sistema -&gt; BancoDeDados: Salvar pagamento vinculado à O.S.\n    Sistema -&gt; BancoDeDados: Registrar entrada financeira\n    BancoDeDados --&gt; Sistema: Pagamento e movimentação registrados\n    Sistema --&gt; Cliente: Confirmar pagamento\n\nelse Cliente recusa o orçamento\n    Cliente -&gt; Sistema: Recusar orçamento\n    Sistema -&gt; BancoDeDados: Registrar recusa e data\n    Sistema -&gt; BancoDeDados: Atualizar status da O.S. para Cancelada\n    BancoDeDados --&gt; Sistema: O.S. atualizada\n    Sistema --&gt; Cliente: Confirmar cancelamento da O.S.\nend\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Ce65jpyOgdPL8ikugjU4-1">
